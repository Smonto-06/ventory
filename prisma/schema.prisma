// Ventory POS — Prisma Schema
// PostgreSQL + multi-tenant by businessId

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Con Neon: DATABASE_URL = conexión "pooled" (para la app en Vercel)
  // y DIRECT_URL = conexión directa (para migraciones). En local usa la misma en ambas.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  SUPERVISOR
  CASHIER
  SELLER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MIXED
  CREDIT
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum BusinessStatus {
  TRIAL // prueba gratis — funcional hasta trialEndsAt
  ACTIVE // plan activo (activado por el super-admin tras el pago)
  SUSPENDED // suspendido — solo lectura hasta reactivar
}

enum PlanPaymentStatus {
  PENDING // checkout creado, esperando el resultado de Wompi
  APPROVED // pago aprobado — extendió la vigencia del plan
  DECLINED // rechazado por el banco o cancelado por el usuario
  VOIDED // anulado en Wompi
  ERROR // falló en la pasarela

  @@map("plan_payment_status")
}

enum MovementType {
  SALE // decremented by a sale
  RETURN // incremented by a return/refund
  ADJUSTMENT // manual stock correction
  PURCHASE // stock received from supplier
}

enum CashMovementType {
  INCOME // ingreso — base de caja, abono de cliente, otro ingreso
  EXPENSE // gasto — pago a proveedor, servicios, domicilios, devolución, anulación, otro
  WITHDRAWAL // retiro — efectivo retirado de la caja (legado)
}

enum PurchaseMethod {
  CASH // contado — pagada completa + gasto de caja "Pago a proveedor"
  TRANSFER // transferencia — pagada completa sin afectar caja física
  CREDIT // crédito — saldo pendiente al proveedor (abono inicial opcional)
}

enum QuoteStatus {
  OPEN
  CONVERTED
  CANCELLED

  @@map("quote_status")
}

enum ReturnType {
  REFUND // devolución — reembolso en efectivo (gasto de caja)
  EXCHANGE // cambio — el valor devuelto se aplica como descuento en una nueva venta
}

// ─── Core Models ────────────────────────────────────────────────────────────

model Business {
  id                   String  @id @default(cuid())
  name                 String
  slug                 String  @unique
  taxId                String?
  phone                String?
  address              String?
  // Mensaje final impreso en la factura de venta (p. ej. "¡Gracias por su compra!")
  receiptFooter        String?
  currency             String  @default("COP")
  locale               String  @default("es-CO")
  isActive             Boolean @default(true)
  allowNegativeStock   Boolean @default(false)
  barcodeEnabled       Boolean @default(true)
  // IVA incluido en el precio: desglose informativo = total × pct / (100 + pct)
  ivaPct               Decimal @default(0) @db.Decimal(5, 2)
  defaultOpeningAmount Decimal @default(0) @db.Decimal(12, 2)

  // ── Notificaciones automáticas ──
  // Resumen del día por correo al cierre y aviso de productos agotados.
  // Van juntos en un mismo correo para no llenar la bandeja del dueño.
  notifyDailySummary Boolean @default(false)
  notifyLowStock     Boolean @default(true)
  /// Destino del resumen; si está vacío se usa el correo del dueño
  notifyEmail        String?
  /// Última vez que salió el correo de resumen diario — evita reenviarlo dos
  /// veces el mismo día si Vercel reintenta la invocación del cron (el cron
  /// no tiene ninguna otra forma de saber si ya corrió hoy).
  lastDailySummaryAt DateTime?

  // Plan comercial: los negocios nuevos entran en prueba (el registro lo fija);
  // los existentes quedan ACTIVE por el default
  status      BusinessStatus @default(ACTIVE)
  trialEndsAt DateTime?
  activatedAt DateTime?
  adminNotes  String?
  /// Vigencia pagada por Wompi. null en ACTIVE = activación manual sin
  /// vencimiento (comportamiento anterior); con fecha, el plan bloquea al
  /// vencerse y cada pago aprobado suma 30 días sobre lo que quede.
  paidUntil   DateTime?
  /// IP desde donde se registró el negocio: el super admin ve cuando varios
  /// negocios nacen de la misma conexión (posible prueba gratis repetida).
  /// Solo visibilidad — nunca bloqueo automático: en Colombia barrios enteros
  /// comparten IP y castigaría clientes legítimos.
  signupIp    String?

  branches      Branch[]
  users         User[]
  products      Product[]
  quotes        Quote[]
  categories    Category[]
  customers     Customer[]
  suppliers     Supplier[]
  purchases     Purchase[]
  heldSales     HeldSale[]
  heldPurchases HeldPurchase[]
  planPayments  PlanPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("businesses")
}

/// Pago de la mensualidad vía pasarela. La referencia es única: el webhook y
/// la consulta de respaldo pueden llegar por el mismo pago sin duplicar los
/// 30 días (la extensión solo se aplica al pasar de PENDING a APPROVED).
model PlanPayment {
  id            String            @id @default(cuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Pasarela que procesó este pago: 'wompi' o 'mercadopago'
  gateway       String            @default("wompi")
  /// Referencia enviada a la pasarela (VEN-…), con la que vuelve el evento
  reference     String            @unique
  /// Monto en centavos como lo exige Wompi ($49.900 → 4990000)
  amountInCents Int
  currency      String            @default("COP")
  status        PlanPaymentStatus @default(PENDING)
  /// Id de la transacción en la pasarela (Wompi o Mercado Pago), para
  /// rastrear en su panel. El nombre quedó de cuando solo existía Wompi.
  wompiId       String?
  /// Método reportado por Wompi: CARD, NEQUI, PSE, BANCOLOMBIA_TRANSFER…
  paymentMethod String?
  paidAt        DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([businessId, createdAt])
  @@map("plan_payments")
}

model Branch {
  id       String  @id @default(cuid())
  name     String
  // Consecutivo de facturación atómico: se incrementa con UPDATE … RETURNING,
  // así dos cajas vendiendo a la vez nunca generan el mismo folio
  saleSeq  Int     @default(0)
  /// Consecutivo de cotizaciones, con la misma garantía atómica que saleSeq
  quoteSeq Int     @default(0)
  address  String?
  phone    String?
  isActive Boolean @default(true)

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  users        User[]
  inventory    Inventory[]
  sales        Sale[]
  quotes       Quote[]
  cashSessions CashSession[]
  purchases    Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  name              String?
  role              UserRole  @default(CASHIER)
  pin               String?
  isActive          Boolean   @default(true)
  failedAttempts    Int       @default(0)
  lockedAt          DateTime?
  // Recuperación de contraseña (token de un solo uso, con vencimiento)
  resetToken        String?   @unique
  resetTokenExpires DateTime?
  // Verificación de correo al registrarse (null = pendiente de verificar).
  // A diferencia de resetToken, antes no vencía nunca: un enlace de
  // verificación sin usar quedaba vigente indefinidamente.
  emailVerified      DateTime?
  verifyToken        String?   @unique
  verifyTokenExpires DateTime?

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  accounts           Account[]
  sessions           Session[]
  sales              Sale[]
  voidedSales        Sale[]              @relation("SaleVoidedBy")
  quotes             Quote[]             @relation("QuoteCreatedBy")
  cashSessions       CashSession[]       @relation("CashSessionOpenedBy")
  cashSessionsClosed CashSession[]       @relation("CashSessionClosedBy")
  cashMovements      CashMovement[]
  inventoryMovements InventoryMovement[]
  auditLogs          AuditLog[]
  purchases          Purchase[]
  purchasePayments   PurchasePayment[]
  customerPayments   CustomerPayment[]
  saleReturns        SaleReturn[]
  heldSales          HeldSale[]
  heldPurchases      HeldPurchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ─── Products & Inventory ───────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
  @@map("categories")
}

model Product {
  id            String        @id @default(cuid())
  sku           String?
  name          String
  description   String?
  barcode       String?
  price         Decimal       @db.Decimal(12, 2)
  cost          Decimal?      @db.Decimal(12, 2)
  taxRate       Decimal       @default(0.16) @db.Decimal(5, 4)
  unitOfMeasure String?
  supplier      String? // legado: nombre libre — usar supplierId
  imageUrl      String?
  status        ProductStatus @default(ACTIVE)

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  supplierId  String?
  supplierRef Supplier? @relation(fields: [supplierId], references: [id])

  // ── Variantes (talla, color, presentación…) ──
  // El "padre" (hasVariants) solo agrupa: no se vende ni tiene inventario.
  // Las variantes son productos normales con su propio stock, SKU y precio,
  // de modo que ventas, compras, kardex y reportes siguen funcionando igual.
  hasVariants    Boolean   @default(false)
  /// Definición de las opciones del padre: [{ nombre, valores[] }]
  variantOptions Json?
  parentId       String?
  parent         Product?  @relation("VariantesProducto", fields: [parentId], references: [id])
  variants       Product[] @relation("VariantesProducto")
  /// Combinación de esta variante, p. ej. "M / Azul"
  variantLabel   String?

  inventory     Inventory[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  quoteItems    QuoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, sku])
  @@index([businessId, status])
  @@index([businessId, parentId])
  @@index([barcode])
  @@map("products")
}

model Inventory {
  id       String  @id @default(cuid())
  quantity Decimal @default(0) @db.Decimal(12, 3)
  minStock Decimal @default(0) @db.Decimal(12, 3)
  maxStock Int?
  lowStock Boolean @default(false)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  movements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, branchId])
  @@map("inventory")
}

model InventoryMovement {
  id             String       @id @default(cuid())
  type           MovementType
  quantity       Decimal      @db.Decimal(12, 3)
  quantityBefore Decimal      @db.Decimal(12, 3)
  quantityAfter  Decimal      @db.Decimal(12, 3)
  reason         String?

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])

  saleItemId String?
  saleItem   SaleItem? @relation(fields: [saleItemId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([inventoryId, createdAt])
  @@map("inventory_movements")
}

// ─── Sales ──────────────────────────────────────────────────────────────────

model Sale {
  id             String        @id @default(cuid())
  folio          String
  status         SaleStatus    @default(COMPLETED)
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @default(CASH)
  amountPaid     Decimal       @db.Decimal(12, 2)
  changeGiven    Decimal       @default(0) @db.Decimal(12, 2)
  discountIsPct  Boolean       @default(false)
  discountPct    Decimal       @default(0) @db.Decimal(5, 2)
  notes          String?
  voidedAt       DateTime?
  voidReason     String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  cashierId String
  cashier   User   @relation(fields: [cashierId], references: [id])

  cashSessionId String
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  voidedById String?
  voidedBy   User?   @relation("SaleVoidedBy", fields: [voidedById], references: [id])

  items    SaleItem[]
  payments SalePayment[]
  returns  SaleReturn[]
  /// Cotización de la que salió esta venta, si vino de una
  quote    Quote?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, folio])
  @@index([branchId, createdAt])
  @@index([cashSessionId])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(cuid())
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @db.Decimal(5, 4)
  taxAmount   Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  discountPct Decimal  @default(0) @db.Decimal(5, 2)
  returnedQty Decimal  @default(0) @db.Decimal(12, 3)
  costPrice   Decimal? @db.Decimal(12, 2)

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  movements   InventoryMovement[]
  returnItems SaleReturnItem[]

  @@map("sale_items")
}

// Métodos de cobro combinados de una venta (Efectivo + Tarjeta + Transferencia con montos)
model SalePayment {
  id     String        @id @default(cuid())
  method PaymentMethod
  amount Decimal       @db.Decimal(12, 2)

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@map("sale_payments")
}

// Devolución o cambio sobre una venta histórica
model SaleReturn {
  id          String     @id @default(cuid())
  type        ReturnType
  totalRefund Decimal    @db.Decimal(12, 2)
  notes       String?

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  cashMovementId String?       @unique
  cashMovement   CashMovement? @relation(fields: [cashMovementId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  items SaleReturnItem[]

  createdAt DateTime @default(now())

  @@index([saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String  @id @default(cuid())
  quantity     Decimal @db.Decimal(12, 3)
  refundAmount Decimal @db.Decimal(12, 2)

  returnId String
  return   SaleReturn @relation(fields: [returnId], references: [id])

  saleItemId String
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id])

  @@map("sale_return_items")
}

// ─── Cash Register ──────────────────────────────────────────────────────────

model CashSession {
  id              String            @id @default(cuid())
  status          CashSessionStatus @default(OPEN)
  terminal        String?
  openingBalance  Decimal           @db.Decimal(12, 2)
  closingBalance  Decimal?          @db.Decimal(12, 2)
  expectedBalance Decimal?          @db.Decimal(12, 2)
  difference      Decimal?          @db.Decimal(12, 2)
  /// Congelados al cerrar (igual que expectedBalance/difference): si una
  /// venta del turno se anula DESPUÉS del cierre, el historial de turnos no
  /// debe "esconderla" del total recalculándolo en vivo mientras el resto
  /// del resumen (esperado, contado, diferencia) se queda con el valor de
  /// cuando se cerró — mostraría un cierre que ya no cuadra consigo mismo.
  salesTotal      Decimal?          @db.Decimal(12, 2)
  incomesTotal    Decimal?          @db.Decimal(12, 2)
  expensesTotal   Decimal?          @db.Decimal(12, 2)
  notes           String?
  closingNotes    String?
  openedAt        DateTime          @default(now())
  closedAt        DateTime?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  openedById String
  openedBy   User   @relation("CashSessionOpenedBy", fields: [openedById], references: [id])

  closedById String?
  closedBy   User?   @relation("CashSessionClosedBy", fields: [closedById], references: [id])

  sales     Sale[]
  movements CashMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status])
  @@index([openedById, status])
  @@map("cash_sessions")
}

model CashMovement {
  id          String           @id @default(cuid())
  type        CashMovementType
  amount      Decimal          @db.Decimal(12, 2)
  // Descripciones del prototipo — ingresos: Base de caja, Abono de cliente, Otro ingreso;
  // gastos: Pago a proveedor, Servicios públicos, Domicilios, Devolución, Anulación de venta, Otro gasto
  description String
  comment     String?

  cashSessionId String
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  purchasePayment PurchasePayment?
  customerPayment CustomerPayment?
  saleReturn      SaleReturn?

  createdAt DateTime @default(now())

  @@index([cashSessionId])
  @@map("cash_movements")
}

// ─── Customers ──────────────────────────────────────────────────────────────

model Customer {
  id       String  @id @default(cuid())
  name     String
  phone    String?
  email    String?
  document String?
  address  String?
  notes    String?
  balance  Decimal @default(0) @db.Decimal(12, 2)

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  sales    Sale[]
  quotes   Quote[]
  payments CustomerPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, name])
  @@map("customers")
}

// Abono de cliente: descuenta su saldo de crédito; si es en efectivo genera ingreso de caja
model CustomerPayment {
  id           String        @id @default(cuid())
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod @default(CASH)
  balanceAfter Decimal       @db.Decimal(12, 2)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  cashMovementId String?       @unique
  cashMovement   CashMovement? @relation(fields: [cashMovementId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
  @@map("customer_payments")
}

// ─── Suppliers & Purchases ──────────────────────────────────────────────────

model Supplier {
  id       String  @id @default(cuid())
  name     String
  phone    String?
  isActive Boolean @default(true)

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  products  Product[]
  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
  @@map("suppliers")
}

// Compra a proveedor: por producto actualiza stock += qty, costo y precio nuevos
model Purchase {
  id         String         @id @default(cuid())
  method     PurchaseMethod @default(CASH)
  total      Decimal        @db.Decimal(12, 2)
  // Abono acumulado. Saldo pendiente = total − paidAmount
  paidAmount Decimal        @default(0) @db.Decimal(12, 2)
  notes      String?

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  items    PurchaseItem[]
  payments PurchasePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id        String   @id @default(cuid())
  quantity  Decimal  @db.Decimal(12, 3)
  unitCost  Decimal  @db.Decimal(12, 2)
  totalCost Decimal  @db.Decimal(12, 2)
  // Nuevo precio de venta del producto tras la compra (ganancia % ↔ precio enlazados en el frontend)
  newPrice  Decimal? @db.Decimal(12, 2)

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

// Pago/abono a una compra a crédito; si es en efectivo genera gasto de caja "Pago a proveedor"
model PurchasePayment {
  id     String        @id @default(cuid())
  amount Decimal       @db.Decimal(12, 2)
  method PaymentMethod @default(CASH)

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])

  cashMovementId String?       @unique
  cashMovement   CashMovement? @relation(fields: [cashMovementId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([purchaseId])
  @@map("purchase_payments")
}

// ─── Esperas (ventas y compras en pausa) ────────────────────────────────────

model HeldSale {
  id           String  @id @default(cuid())
  customerName String?
  itemCount    Int     @default(0)
  total        Decimal @default(0) @db.Decimal(12, 2)
  // Carrito serializado: [{ productId, quantity, unitPrice, discountPct }], descuento total, etc.
  payload      Json

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@map("held_sales")
}

model HeldPurchase {
  id           String  @id @default(cuid())
  supplierName String?
  total        Decimal @default(0) @db.Decimal(12, 2)
  payload      Json

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@map("held_purchases")
}

// ─── Audit ──────────────────────────────────────────────────────────────────

model AuditLog {
  id        String  @id @default(cuid())
  action    String
  entity    String
  entityId  String
  payload   Json?
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ─── NextAuth.js Adapter Tables ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Cotizaciones ────────────────────────────────────────────────────────────
// Una cotización es una promesa de precio, no una venta: NO mueve inventario,
// NO mueve caja y NO consume folio de facturación. Solo cuando el cliente
// vuelve y se convierte, se crea una venta por el camino normal (que sí mueve
// stock y caja). Por eso aquí no hay ninguna referencia a Inventory.

model Quote {
  id             String      @id @default(cuid())
  folio          String
  status         QuoteStatus @default(OPEN)
  subtotal       Decimal     @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  discountIsPct  Boolean     @default(false)
  discountPct    Decimal     @default(0) @db.Decimal(5, 2)
  total          Decimal     @db.Decimal(12, 2)
  notes          String?
  /// Hasta cuándo se respeta el precio cotizado
  validUntil     DateTime
  cancelledAt    DateTime?
  convertedAt    DateTime?

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  /// Nombre libre cuando el cliente no está en el catálogo
  customerName String?

  createdById String
  createdBy   User   @relation("QuoteCreatedBy", fields: [createdById], references: [id])

  /// Venta que resultó de convertirla; único, para que no se convierta dos veces
  saleId String? @unique
  sale   Sale?   @relation(fields: [saleId], references: [id])

  items QuoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, folio])
  @@index([businessId, status])
  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(cuid())
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  discountPct Decimal @default(0) @db.Decimal(5, 2)
  total       Decimal @db.Decimal(12, 2)

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@map("quote_items")
}
