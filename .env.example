# ── Base de datos PostgreSQL ─────────────────────────────────────────────────
# Neon (producción): DATABASE_URL = cadena "Pooled connection" del panel de Neon
#                    DIRECT_URL   = cadena "Direct connection" (para migraciones)
# Local (desarrollo): usa la misma URL en ambas variables
DATABASE_URL="postgresql://ventory:ventory_dev@localhost:5432/ventory_dev"
DIRECT_URL="postgresql://ventory:ventory_dev@localhost:5432/ventory_dev"

# ── NextAuth.js ──────────────────────────────────────────────────────────────
# Genera un secreto seguro con: openssl rand -base64 32
# (o escribe una frase larga y aleatoria de más de 32 caracteres)
NEXTAUTH_SECRET="tu-secreto-super-seguro-aqui"
# En producción: la URL pública de tu app, p. ej. https://ventory-tunegocio.vercel.app
NEXTAUTH_URL="http://localhost:3000"
