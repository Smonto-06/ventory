# ── Base de datos PostgreSQL ─────────────────────────────────────────────────
# Neon (producción): DATABASE_URL = cadena "Pooled connection" del panel de Neon
#                    DIRECT_URL   = cadena "Direct connection" (para migraciones)
# Local (desarrollo): usa la misma URL en ambas variables
DATABASE_URL="postgresql://ventory:ventory_dev@localhost:5432/ventory_dev"
DIRECT_URL="postgresql://ventory:ventory_dev@localhost:5432/ventory_dev"

# ── NextAuth.js ──────────────────────────────────────────────────────────────
# Genera un secreto seguro con: openssl rand -base64 32
# (o escribe una frase larga y aleatoria de más de 32 caracteres)
NEXTAUTH_SECRET="tu-secreto-super-seguro-aqui"
# En producción: la URL pública de tu app, p. ej. https://ventory-tunegocio.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ── Correo del sistema (Contáctanos) ─────────────────────────────────────────
# Contraseña de aplicación de Google (myaccount.google.com/apppasswords)
GMAIL_USER="ventorypos@gmail.com"
GMAIL_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
# Destino de los mensajes de soporte (por defecto, el mismo GMAIL_USER)
# CONTACT_EMAIL="ventorypos@gmail.com"

# ── Plataforma (super-admin) ─────────────────────────────────────────────────
# Correo del dueño de la plataforma: habilita el panel /admin para activar,
# suspender o extender la prueba de los negocios registrados
SUPER_ADMIN_EMAIL="tu-correo-de-login@ejemplo.com"

# ─── Notificaciones automáticas ───
# Secreto del cron de Vercel: sin él la ruta /api/cron/* no responde.
# Ponlo en Vercel (Settings → Environment Variables) con cualquier texto largo
# y aleatorio; Vercel lo envía solo en cada ejecución programada.
CRON_SECRET=""

# Servidor de correo alterno (opcional). Si no se define, se usa Gmail con
# GMAIL_USER y GMAIL_APP_PASSWORD.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
